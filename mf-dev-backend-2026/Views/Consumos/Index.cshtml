@model IEnumerable<mf_dev_backend_2026.Models.Consumo>

@{
    ViewData["Title"] = "Index";
}

<h1>Consumos</h1>

<p>
    <a asp-action="Create" class="btn btn-outline-success" >Novo consumo +</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Km)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Veiculo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Descricao)
            </td>
            <td>
                @Html.DisplayFor(model => item.Data)
            </td>
            <td>
                @Html.DisplayFor(model => item.Valor)
            </td>
            <td>
                @Html.DisplayFor(model => item.Km)
            </td>
            <td>
                @Html.DisplayFor(model => item.Tipo)
            </td>
            
            <td>
                @Html.DisplayFor(model => item.Veiculo.Nome)
            </td>
            <td>
                <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Visualizar</a> |
                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
